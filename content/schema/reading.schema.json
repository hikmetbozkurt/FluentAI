{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluentai.seanora.com/schemas/reading.schema.json",
  "title": "FluentAI Reading Article Schema",
  "description": "Schema for offline-first CEFR-graded reading texts with paragraph annotations, Turkish translations, and comprehension checks.",
  "type": "object",
  "required": [
    "id",
    "title",
    "cefr_level",
    "category",
    "summary_en",
    "summary_tr",
    "word_count",
    "estimated_reading_minutes",
    "paragraphs",
    "comprehension_questions",
    "topic_tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^reading\\.[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)?$",
      "description": "Stable semantic content identifier, e.g. reading.b2.microservices-architecture"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "description": "Article title in English"
    },
    "cefr_level": {
      "type": "string",
      "enum": ["A2", "B1", "B2", "C1", "C2"],
      "description": "Target CEFR level"
    },
    "category": {
      "type": "string",
      "enum": [
        "technology",
        "leadership_and_management",
        "business_strategy",
        "engineering_culture",
        "finance_and_economics",
        "workplace_communication"
      ],
      "description": "Domain topic category"
    },
    "summary_en": {
      "type": "string",
      "minLength": 10,
      "description": "Executive summary in English"
    },
    "summary_tr": {
      "type": "string",
      "minLength": 10,
      "description": "Executive summary in Turkish"
    },
    "word_count": {
      "type": "integer",
      "minimum": 30
    },
    "estimated_reading_minutes": {
      "type": "integer",
      "minimum": 1
    },
    "paragraphs": {
      "type": "array",
      "minItems": 2,
      "description": "Structured sequence of article paragraphs",
      "items": {
        "type": "object",
        "required": ["paragraph_index", "content_en", "content_tr"],
        "properties": {
          "paragraph_index": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "content_en": {
            "type": "string",
            "minLength": 20
          },
          "content_tr": {
            "type": "string",
            "minLength": 20
          }
        },
        "additionalProperties": false
      }
    },
    "vocabulary_annotations": {
      "type": "array",
      "description": "Targeted lexical items glossed in context",
      "items": {
        "type": "object",
        "required": ["word", "context_definition_en", "context_meaning_tr"],
        "properties": {
          "word": {
            "type": "string",
            "minLength": 1
          },
          "vocab_id": {
            "type": "string",
            "pattern": "^vocab\\.[a-z0-9_-]+$"
          },
          "context_definition_en": {
            "type": "string",
            "minLength": 5
          },
          "context_meaning_tr": {
            "type": "string",
            "minLength": 2
          }
        },
        "additionalProperties": false
      }
    },
    "comprehension_questions": {
      "type": "array",
      "minItems": 2,
      "description": "Multiple choice reading comprehension questions",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question_en",
          "options",
          "correct_answer",
          "explanation_en",
          "explanation_tr"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question_en": {
            "type": "string",
            "minLength": 5
          },
          "question_tr_hint": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "correct_answer": {
            "type": "string",
            "minLength": 1
          },
          "explanation_en": {
            "type": "string",
            "minLength": 10
          },
          "explanation_tr": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    },
    "topic_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "related_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(vocab|grammar|speaking|reading|listening)\\.[a-z0-9_-]+$"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "AI_REVIEWED",
        "VALIDATED",
        "APPROVED",
        "PUBLISHED",
        "DEPRECATED"
      ],
      "default": "APPROVED"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    }
  },
  "additionalProperties": false
}
